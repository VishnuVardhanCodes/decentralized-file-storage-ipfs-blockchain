# Hardhat Blockchain Environment Configuration
# Optional: Sepolia Testnet RPC URL (e.g. Alchemy, Infura, or public RPC)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key

# Optional: Private key for testnet deployment (DO NOT use real funds, use testnet account)
PRIVATE_KEY=your_private_key_without_0x_prefix

# Optional: Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: Local development wallet funding recipient
# Provide your personal MetaMask account address here to fund it with local test ETH:
RECIPIENT_ADDRESS=0xYourMetaMaskAddressHere
AMOUNT_ETH=10.0
