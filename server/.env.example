# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# File Upload Constraints
MAX_FILE_SIZE_BYTES=52428800 # 50 MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain,text/csv,application/json,application/zip,application/x-zip-compressed

# IPFS Provider Configuration
# Set IPFS_PROVIDER to 'pinata', 'local_node', or 'auto'
IPFS_PROVIDER=auto

# Pinata IPFS Configuration (Recommended for production/testnet)
# Get your JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Dedicated/Public IPFS Gateways (Fallback array)
IPFS_PUBLIC_GATEWAYS=https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/,https://cloudflare-ipfs.com/ipfs/

# Local IPFS Node API (Optional if running Kubo / go-ipfs locally)
IPFS_API_URL=http://127.0.0.1:5001
